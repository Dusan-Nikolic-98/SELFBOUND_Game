{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist-tests",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/camera.ts",
    "src/collision.ts",
    "src/logic.ts",
    "src/types.ts",
    "src/validation.ts",
    "tests/**/*.ts"
  ]
}
