{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist-tests",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "frontend/src/camera.ts",
    "frontend/src/game.ts",
    "frontend/src/input.ts",
    "frontend/src/level.ts",
    "frontend/src/collision.ts",
    "frontend/src/logic.ts",
    "frontend/src/types.ts",
    "frontend/src/validation.ts",
    "tests/**/*.ts"
  ]
}
