{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "backend/dist",
    "rootDir": "backend/src",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["backend/src/**/*.ts"]
}
